{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imchong.github.io/Robot_Learning_IO_Board/schema/registry.schema.json",
  "title": "Robot Learning IO Board — 项目注册表（data/projects.json）",
  "description": "站点的项目索引。项目文件按需加载，所以选择器要用到的展示信息（name / subtitle / group / published / venue / keywords）放在这里，不必先下载每个项目文件。name 与 subtitle 是项目文件里同名字段的冗余，scripts/validate.mjs 会校验两处一致。",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "defaultProject": {
      "type": "string",
      "description": "首次打开时显示的项目 id，必须在 projects 里注册过。"
    },
    "defaultMode": { "type": "string", "default": "train" },
    "groups": {
      "type": "array",
      "description": "项目分组。项目多起来之后这是选择器里唯一的导航结构，按方法族划分最实用。只要有项目声明了 group，选择器就会显示分组标题。",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "desc": { "type": "string", "description": "一句话说明这一族的共同点，显示在分组标题下。" }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "file": { "type": "string", "description": "相对 data/ 的文件名。" },
          "name": { "type": "string", "description": "必须与项目文件里的 name 一致。" },
          "subtitle": { "type": "string", "description": "填了就必须与项目文件里的 subtitle 一致。" },
          "group": { "type": "string", "description": "groups 里的分组 id。" },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "首次公开发表的日期（有预印本就以预印本首版为准，否则取会议/期刊日期）。项目列表按「分组顺序 → 发布时间」排，所以这是排序的唯一依据，不再手工编号。"
          },
          "venue": {
            "type": "string",
            "description": "发表处，如 \"SIGGRAPH 2021 · TOG 40(4)\"、\"arXiv 预印本\"。只用于展示。"
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "只参与搜索、不显示。放机器人型号、仿真器、算法、机构、代码仓名、arXiv 号这类读者可能拿来搜的词，中英文都可以。"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
