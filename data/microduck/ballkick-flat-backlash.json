    "mjlab 框架": "https://github.com/mujocolab/mjlab",
    "BAM 执行器模型": "https://github.com/Rhoban/bam",
    "齿隙实现": "https://github.com/pollen-robotics/microduck_rl/blob/main/src/mjlab_microduck/tasks/backlash.py"
  },
