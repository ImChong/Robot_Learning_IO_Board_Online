            "symbol": "action_rate_l2"
          }
        },
        {
          "id": "neck_action_rate_l2",
          "group": "D",
          "label": "颈部动作变化率",
          "weight": -0.5,
          "direction": "negative",
          "confidence": "verified",
          "form": "\\lVert a^{\\text{neck}}_t-a^{\\text{neck}}_{t-1}\\rVert^{2}",
          "desc": "颈、头 4 个动作的相邻步差平方和，在 action_rate_l2 之外对头部再加一层平滑。",
          "note": "与 action_rate_l2 重叠：头部动作的变化同时被两项惩罚。函数：mjlab_microduck.tasks.mdp.neck_action_rate_l2（mdp.py:437）。",
          "source": {
            "repo": "pollen-robotics/microduck_rl",
